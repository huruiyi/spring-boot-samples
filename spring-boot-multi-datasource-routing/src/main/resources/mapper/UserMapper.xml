<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.routing.mapper.UserMapper">
    <select id="findAll" resultType="com.example.routing.model.User">
        SELECT id, name, email FROM t_user
    </select>
    <insert id="insert" parameterType="com.example.routing.model.User">
        INSERT INTO t_user (name, email) VALUES (#{name}, #{email})
    </insert>
</mapper>
